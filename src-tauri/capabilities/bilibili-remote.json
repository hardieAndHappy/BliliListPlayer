{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bilibili-remote",
  "description": "Bilibili 嵌入子 webview：仅事件收发，禁止调用应用自定义命令（CVE-2024-35222 纵深防御）",
  "webviews": ["bilibili"],
  "remote": {
    "urls": ["https://*.bilibili.com"]
  },
  "permissions": [
    "core:event:allow-emit",
    "core:event:allow-listen"
  ]
}
